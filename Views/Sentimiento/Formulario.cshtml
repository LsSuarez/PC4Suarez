@{
    ViewData["Title"] = "Analizar Sentimiento";
    var resultado = ViewBag.Sentimiento as string;
    var esPositivo = resultado != null && resultado.ToLower() == "positivo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">🧠 Analizar Sentimiento</h4>
                </div>
                <div class="card-body bg-light">

                    <form method="post" asp-action="Predecir" asp-controller="Sentimiento">
                        <div class="mb-3">
                            <label for="texto" class="form-label">Escribe tu opinión</label>
                            <textarea class="form-control" id="texto" name="texto" rows="4"
                                      placeholder="Ej: El producto llegó a tiempo y funciona excelente...">@ViewBag.TextoIngresado</textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            🔍 Analizar Sentimiento
                        </button>
                    </form>

                    @if (ViewBag.Sentimiento != null)
                    {
                        <div class="alert @((esPositivo ? "alert-success" : "alert-danger")) mt-4 text-center" role="alert">
                            <h5 class="fw-bold mb-2">Resultado: @ViewBag.Sentimiento</h5>
                            <p class="mb-0">📊 Confianza: <strong>@ViewBag.Score</strong></p>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
